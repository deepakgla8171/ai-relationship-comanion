# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Database Configuration
# Leave empty or set to 'demo' to run in zero-config In-Memory Demo Mode
MONGODB_URI=mongodb://localhost:27017/ai-relationship-companion

# AI Provider Configuration
# Supported providers: 'demo' (deterministic fallback), 'gemini', 'openai'
AI_PROVIDER=demo
AI_MODEL=demo-sentiment-v1

# External AI Provider API Keys (Leave blank for Demo Mode)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# User Consent for External AI (Strict Guardrail)
# Even if an API key is provided, user consent must be explicitly granted per session
REQUIRE_EXTERNAL_AI_CONSENT=true

# Upload and Storage Limits
MAX_UPLOAD_SIZE_MB=5
MAX_CONTEXT_MESSAGES=15
DATA_RETENTION_DAYS=30
